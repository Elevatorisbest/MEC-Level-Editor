<ctrl:FrostyDockableWindow
    x:Class="LevelEditorPlugin.SubWorlds.SubWorldPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
    Title="Sub-worlds to Load"
    Width="760"
    Height="760"
    MinWidth="560"
    MinHeight="420"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner">

    <ctrl:FrostyDockableWindow.Resources>
        <!--  Frosty's checkbox with light text (the default control style sets black text)  -->
        <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource FontColor}" />
            <Setter Property="Padding" Value="5,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="24" />
        </Style>
    </ctrl:FrostyDockableWindow.Resources>

    <Grid Background="#141414" TextElement.Foreground="#F8F8F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Level, search and presets  -->
        <Border Grid.Row="0" Padding="8,8,8,6" Background="#202020">
            <StackPanel>
                <DockPanel x:Name="Panel_Level" Margin="0,0,0,6" LastChildFill="True">
                    <TextBlock
                        Width="44"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="Level" />
                    <ComboBox
                        x:Name="ComboBox_Level"
                        Height="24"
                        SelectionChanged="ComboBox_Level_SelectionChanged"
                        ToolTip="The level whose sub-world choice you are editing" />
                </DockPanel>
                <TextBlock
                    x:Name="Text_LevelName"
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
                <DockPanel LastChildFill="False">
                    <ctrl:FrostyWatermarkTextBox
                        x:Name="TextBox_Search"
                        Width="250"
                        Height="24"
                        VerticalContentAlignment="Center"
                        DockPanel.Dock="Left"
                        TextChanged="TextBox_Search_TextChanged"
                        ToolTip="Words from a sub-world, mission or category name, e.g. 'shard' or 'downtown hub'. All words have to match."
                        WatermarkText="Search sub-worlds and missions" />
                    <Button
                        Margin="4,0,14,0"
                        Click="Button_ClearSearch_Click"
                        Content="Clear"
                        DockPanel.Dock="Left" />
                    <Button
                        Margin="0,0,4,0"
                        Click="Button_Everything_Click"
                        Content="Everything"
                        DockPanel.Dock="Left"
                        ToolTip="Tick every sub-world (as the editor did before)." />
                    <Button
                        Margin="0,0,4,0"
                        Click="Button_CityOnly_Click"
                        Content="City only"
                        DockPanel.Dock="Left"
                        ToolTip="The city with its districts, characters, environment and logic, without story missions, side missions, gridnodes, security hubs, city alerts and open-world jobs. Then tick the missions you want." />
                    <Button
                        Margin="0,0,4,0"
                        Click="Button_None_Click"
                        Content="None"
                        DockPanel.Dock="Left"
                        ToolTip="Untick everything; only objects placed directly in the level are loaded." />
                    <Button
                        Margin="4,0,0,0"
                        Click="Button_Collapse_Click"
                        Content="Collapse"
                        DockPanel.Dock="Right" />
                    <Button
                        Margin="4,0,0,0"
                        Click="Button_Expand_Click"
                        Content="Expand"
                        DockPanel.Dock="Right" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock
            Grid.Row="1"
            Margin="10,6,10,6"
            Foreground="#A8A8A8"
            TextWrapping="Wrap">
            Unticked sub-worlds are not loaded in the editor, which also makes the level open faster. They stay in the level and the game still loads them. A sub-world inside one that is unticked is not loaded either. Everything loaded starts visible except mission content you chose not to show and alternative states (ruined, destroyed, after the raid), which you can switch on in the Layers panel.
        </TextBlock>

        <TreeView
            x:Name="TreeView_SubWorlds"
            Grid.Row="2"
            Margin="6,0,6,0"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <TreeView.ItemContainerStyle>
                <Style BasedOn="{StaticResource baseTreeViewItemStyle}" TargetType="{x:Type TreeViewItem}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="Visibility" Value="{Binding Visibility}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Orientation="Horizontal"
                        ToolTip="{Binding ToolTip}">
                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="{Binding TitleWeight}"
                            Text="{Binding Title}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#909090"
                            Text="{Binding Detail}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!--  Options and buttons  -->
        <Border Grid.Row="3" Padding="8" Background="#202020">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="Text_Summary" Margin="0,0,0,6" />
                    <CheckBox
                        x:Name="CheckBox_Show"
                        Margin="0,0,0,4"
                        Content="Show loaded mission and side content in the view"
                        ToolTip="Mission, side mission, gridnode, security hub, city alert and job sub-worlds that the game does not load at start are hidden in the Layers panel by default. With this ticked, the ones you load start visible." />
                    <CheckBox
                        x:Name="CheckBox_Ask"
                        Content="Ask each time a level is opened"
                        ToolTip="Without this, the saved choice is used without asking. Change it any time with Map &gt; Sub-worlds to Load." />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">
                    <Button
                        x:Name="Button_Ok"
                        Margin="0,0,6,0"
                        Click="Button_Ok_Click"
                        Content="Load"
                        IsDefault="True" />
                    <Button
                        x:Name="Button_Cancel"
                        Click="Button_Cancel_Click"
                        Content="Cancel"
                        IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ctrl:FrostyDockableWindow>
