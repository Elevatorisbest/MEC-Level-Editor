<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
    xmlns:editors="clr-namespace:LevelEditorPlugin.Editors">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostyControls;component/Themes/Generic.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate DataType="{x:Type editors:DiagnosticsViewModel}">
        <ctrl:FrostyDockablePanel BorderVisible="False" TitleBarVisible="False">
            <Border BorderBrush="{StaticResource ControlBackground}" BorderThickness="0,2,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel
                        Margin="4"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,4,0"
                            Padding="8,2"
                            Command="{Binding Path=CopyReportCommand}"
                            Content="Copy report"
                            ToolTip="Copy the load report and the log file path to the clipboard" />
                        <Button
                            Margin="0,0,4,0"
                            Padding="8,2"
                            Command="{Binding Path=OpenLogFolderCommand}"
                            Content="Open log folder"
                            ToolTip="Open the LevelEditorLogs folder in Explorer" />
                        <Button
                            Padding="8,2"
                            Command="{Binding Path=RefreshCommand}"
                            Content="Refresh" />
                    </StackPanel>
                    <TextBlock
                        Margin="4,0,4,4"
                        DockPanel.Dock="Top"
                        Foreground="{StaticResource FontColor}"
                        Text="{Binding Path=LogFilePath, StringFormat='Log file: {0}'}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Path=LogFilePath}" />
                    <TextBox
                        Background="{StaticResource ListBackground}"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{StaticResource FontColor}"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="True"
                        Text="{Binding Path=ReportText, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>
        </ctrl:FrostyDockablePanel>
    </DataTemplate>

</ResourceDictionary>
